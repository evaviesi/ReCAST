drug_targets_moa <- read.csv(paste0(data_path, "/drug_targets_moa_", tissue, ".csv"))
case    <- unique(grep("SNU2", SC_obj@meta.data$sample, value=TRUE))
control <- unique(grep("normal", SC_obj@meta.data$sample, value=TRUE))
